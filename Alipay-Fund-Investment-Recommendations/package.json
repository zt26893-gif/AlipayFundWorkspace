{
  "name": "alipay-fund-investment-recommendations",
  "private": true,
  "version": "0.1.0",
  "description": "AI Fund Tracker —— 本地优先的基金持仓、趋势与转换分析工具（Electron 桌面版）",
  "author": "Local",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "serve": "node server/index.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke-test",
    "dist:win": "electron-builder --win portable"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.9.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.local.aifundtracker",
    "productName": "AI Fund Tracker",
    "asar": false,
    "directories": {
      "output": "../.build",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "AI-Fund-Tracker-${version}.exe"
    }
  }
}
